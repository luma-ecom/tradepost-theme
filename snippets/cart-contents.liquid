{%- comment -%} Shared cart body for drawer and cart page. Param: compact (boolean) {%- endcomment -%}
{%- if cart.item_count == 0 -%}
  <div class="cart-empty">
    <p>{{ 'cart.empty' | t }}</p>
    <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  </div>
{%- else -%}
  <form action="{{ routes.cart_url }}" method="post" class="cart-form" data-cart-form novalidate>
    <div class="cart-lines" data-cart-lines>
      {%- for item in cart.items -%}
        {% render 'cart-line', item: item, index: forloop.index %}
      {%- endfor -%}
    </div>

    {%- if settings.cart_minimum_message != blank -%}
      <p class="cart-minimum" data-cart-minimum>{{ settings.cart_minimum_message }}</p>
    {%- endif -%}

    {%- liquid
      assign show_extras = true
      if settings.cart_b2b_fields_only and customer.b2b? != true
        assign show_extras = false
      endif
    -%}
    {%- if show_extras -%}
    <div class="cart-extras">
      {%- if settings.cart_show_po_field -%}
        <label class="field">
          <span class="field__label">{{ 'cart.po_number' | t }}</span>
          <input class="field__input" type="text" name="attributes[PO number]" value="{{ cart.attributes['PO number'] }}" data-cart-attribute="PO number" maxlength="60">
        </label>
      {%- endif -%}
      {%- if settings.cart_show_notes -%}
        <label class="field">
          <span class="field__label">{{ 'cart.note' | t }}</span>
          <textarea class="field__input" name="note" rows="2" data-cart-note>{{ cart.note }}</textarea>
        </label>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="cart-summary">
      {%- for d in cart.cart_level_discount_applications -%}
        <div class="cart-summary__row"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
      {%- endfor -%}
      <div class="cart-summary__row cart-summary__row--total">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-summary__note">
        {%- if customer.b2b? and customer.current_location.metafields.depot.review_orders.value -%}
          {{ 'cart.b2b.submit_for_review' | t }}
        {%- elsif customer.b2b? and customer.current_location.metafields.depot.payment_terms.value != blank -%}
          {{ 'cart.b2b.terms' | t: terms: customer.current_location.metafields.depot.payment_terms.value }}
        {%- else -%}
          {{ 'cart.taxes_shipping_note' | t }}
        {%- endif -%}
      </p>
      <button type="submit" name="checkout" class="btn btn--primary btn--block" data-checkout>
        {%- if customer.b2b? and customer.current_location.metafields.depot.review_orders.value -%}
          {{ 'cart.submit_order' | t }}
        {%- else -%}
          {{ 'cart.checkout' | t }}
        {%- endif -%}
      </button>
      {%- unless compact -%}
        <a class="cart-summary__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      {%- endunless -%}
    </div>
  </form>
{%- endif -%}
