{%- comment -%} Address form fields. Param: form (customer_address form) {%- endcomment -%}
<div class="form__row">
  <label class="field"><span class="field__label">{{ 'customer.register.first_name' | t }}</span><input class="field__input" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
  <label class="field"><span class="field__label">{{ 'customer.register.last_name' | t }}</span><input class="field__input" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
</div>
<label class="field"><span class="field__label">{{ 'customer.register.company' | t }}</span><input class="field__input" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
<label class="field"><span class="field__label">{{ 'customer.addresses.address1' | t }}</span><input class="field__input" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
<label class="field"><span class="field__label">{{ 'customer.addresses.address2' | t }}</span><input class="field__input" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
<div class="form__row">
  <label class="field"><span class="field__label">{{ 'customer.addresses.city' | t }}</span><input class="field__input" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
  <label class="field"><span class="field__label">{{ 'customer.addresses.zip' | t }}</span><input class="field__input" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
</div>
<div class="form__row">
  <label class="field"><span class="field__label">{{ 'customer.addresses.country' | t }}</span>
    <select class="field__input" name="address[country]" data-default="{{ form.country }}" data-address-country>{{ all_country_option_tags }}</select></label>
  <label class="field"><span class="field__label">{{ 'customer.addresses.province' | t }}</span>
    <select class="field__input" name="address[province]" data-default="{{ form.province }}" data-address-province></select></label>
</div>
<label class="field"><span class="field__label">{{ 'customer.register.phone' | t }}</span><input class="field__input" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
<label class="field field--check"><input type="checkbox" name="address[default]"{% if form.set_as_default_checkbox contains 'checked' %} checked{% endif %}> <span>{{ 'customer.addresses.set_default' | t }}</span></label>
