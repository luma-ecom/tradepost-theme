{%- comment -%}
  Section Rendering endpoint for the quick order form (sections/order-form.liquid). Not for the editor.
  Called as <collection url>?section_id=order-form-data&page=N. Returns one JSON page of the catalog the
  buyer can see, with the buyer's own price (B2B catalog applied), volume tiers, quantity rules and stock.
  Record: [id, sku, product, variant, url, price, breaks, min, step, max (0 = none), stock (null = not capped),
  available, backorder]. Price visibility comes from snippets/price.liquid: gated visitors get {"gated":true}.
{%- endcomment -%}
{%- liquid
  assign probe_variant = collection.products.first.selected_or_first_available_variant
-%}
{%- capture price_probe -%}{% render 'price', variant: probe_variant, context: 'line' %}{%- endcapture -%}
{%- if price_probe contains 'data-price-gated' or collection == blank -%}
  <script type="application/json" data-of-data>{"gated":true,"page":1,"pages":1,"v":[]}</script>
{%- else -%}
  {%- paginate collection.products by 100 -%}
    {%- assign sep = '' -%}
    <script type="application/json" data-of-data>
      {"gated":false,"page":{{ paginate.current_page }},"pages":{{ paginate.pages | at_least: 1 }},"v":[
      {%- for product in collection.products -%}
        {%- assign p_title = product.title | json -%}
        {%- for variant in product.variants -%}
          {%- liquid
            assign rule = variant.quantity_rule
            assign tracked = false
            if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
              assign tracked = true
            endif
            assign backorder = 0
            if variant.inventory_management == 'shopify' and variant.inventory_policy == 'continue' and variant.inventory_quantity <= 0
              assign backorder = 1
            endif
          -%}
          {{- sep -}}[{{ variant.id }},{{ variant.sku | default: '' | json }},{{ p_title }},{% if product.has_only_default_variant %}""{% else %}{{ variant.title | json }}{% endif %},{{ variant.url | json }},{{ variant.price }},[{%- for b in variant.quantity_price_breaks -%}[{{ b.minimum_quantity }},{{ b.price }}]{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],{{ rule.min | default: 1 }},{{ rule.increment | default: 1 }},{{ rule.max | default: 0 }},{% if tracked %}{{ variant.inventory_quantity }}{% else %}null{% endif %},{{ variant.available }},{{ backorder }}]
          {%- assign sep = ',' -%}
        {%- endfor -%}
      {%- endfor -%}
      ]}
    </script>
  {%- endpaginate -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.order_form.data_name",
  "tag": "div",
  "settings": []
}
{% endschema %}
