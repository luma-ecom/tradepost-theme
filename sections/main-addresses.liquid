<section class="account section" data-section="{{ section.id }}">
  <div class="page-width account__narrow">
    <a href="{{ routes.account_url }}">&larr; {{ 'customer.account.title' | t }}</a>
    <h1>{{ 'customer.addresses.title' | t }}</h1>
    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div class="address-card">
          <address>{{ address | format_address }}</address>
          {%- if address == customer.default_address -%}<span class="badge">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
          <details><summary>{{ 'customer.addresses.edit' | t }}</summary>
            {%- form 'customer_address', address, class: 'form' -%}
              {% render 'address-fields', form: form %}
              <button type="submit" class="btn btn--primary btn--small">{{ 'customer.addresses.save' | t }}</button>
            {%- endform -%}
          </details>
          {%- form 'customer_address', address -%}
            <button type="submit" class="btn btn--ghost btn--small" formaction="{{ routes.account_addresses_url }}/{{ address.id }}?_method=delete" onclick="return confirm({{ 'customer.addresses.confirm_delete' | t | json }})">{{ 'customer.addresses.delete' | t }}</button>
          {%- endform -%}
        </div>
      {%- endfor -%}
    {%- endpaginate -%}
    <details class="address-new"><summary class="btn btn--secondary">{{ 'customer.addresses.add' | t }}</summary>
      {%- form 'customer_address', customer.new_address, class: 'form' -%}
        {% render 'address-fields', form: form %}
        <button type="submit" class="btn btn--primary">{{ 'customer.addresses.save' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "t:sections.main_addresses.name", "tag": "section", "settings": [] }
{% endschema %}
