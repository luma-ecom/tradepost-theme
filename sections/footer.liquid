<footer class="footer" data-section="{{ section.id }}">
  <div class="page-width footer__grid">
    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        {%- case block.type -%}
        {%- when 'menu' -%}
          {%- if block.settings.title != blank -%}<h3 class="footer__title">{{ block.settings.title }}</h3>{%- endif -%}
          <ul class="footer__links" role="list">
            {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        {%- when 'text' -%}
          {%- if block.settings.title != blank -%}<h3 class="footer__title">{{ block.settings.title }}</h3>{%- endif -%}
          <div class="footer__text rte">{{ block.settings.text }}</div>
        {%- when 'trade' -%}
          <h3 class="footer__title">{{ block.settings.title }}</h3>
          <div class="footer__text rte">{{ block.settings.text }}</div>
          {%- if block.settings.link != blank -%}
            <a class="btn btn--secondary btn--small" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="page-width footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    {%- if section.settings.show_payment_icons -%}
      <ul class="footer__payments" role="list">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:sections.footer.payment_icons", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "t:sections.footer.blocks.menu", "settings": [
      { "type": "text", "id": "title", "label": "t:sections.common.title" },
      { "type": "link_list", "id": "menu", "label": "t:sections.header.menu", "default": "footer" }
    ]},
    { "type": "text", "name": "t:sections.footer.blocks.text", "settings": [
      { "type": "text", "id": "title", "label": "t:sections.common.title" },
      { "type": "richtext", "id": "text", "label": "t:sections.common.text" }
    ]},
    { "type": "trade", "name": "t:sections.footer.blocks.trade", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "t:sections.common.title", "default": "Trade accounts" },
      { "type": "richtext", "id": "text", "label": "t:sections.common.text", "default": "<p>Wholesale pricing, net terms and quick reordering for approved trade customers.</p>" },
      { "type": "url", "id": "link", "label": "t:sections.common.link" },
      { "type": "text", "id": "link_label", "label": "t:sections.common.link_label", "default": "Apply for a trade account" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "title": "Shop" } },
      { "type": "trade" },
      { "type": "text", "settings": { "title": "Contact" } }
    ]
  }
}
{% endschema %}
