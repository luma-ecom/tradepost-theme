<article class="article section" data-section="{{ section.id }}">
  <div class="page-width article__inner">
    {% render 'breadcrumbs' %}
    <h1 class="article__title">{{ article.title | escape }}</h1>
    <p class="article__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
    {%- if article.image -%}{{ article.image | image_url: width: 1400 | image_tag: class: 'article__img' }}{%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>
{% schema %}
{ "name": "t:sections.main_article.name", "tag": "section", "settings": [] }
{% endschema %}
