<section class="account section" data-section="{{ section.id }}">
  <div class="page-width account__narrow">
    <h1>{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span class="field__label">{{ 'customer.login.password' | t }}</span><input class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="field"><span class="field__label">{{ 'customer.activate.confirm' | t }}</span><input class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--primary">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "t:sections.main_reset.name", "tag": "section", "settings": [] }
{% endschema %}
