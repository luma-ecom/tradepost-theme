{%- comment -%}
  Image with text: one image beside heading, text and a button. Image left or right,
  fixed ratio (square / 4:3 / 16:9) or the image's own ratio. Stacks on mobile, image first.
{%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.audience == 'b2b' and customer.b2b? != true
    assign show = false
  elsif section.settings.audience == 'd2c' and customer.b2b?
    assign show = false
  endif

  assign img = section.settings.image
  case section.settings.ratio
    when 'square'
      assign ratio = 1
    when '4-3'
      assign ratio = 1.3333
    when '16-9'
      assign ratio = 1.7778
    else
      assign ratio = 1.3333
      if img != blank
        assign ratio = img.aspect_ratio
      endif
  endcase
-%}
{%- if show -%}
<section class="iwt section" data-section="{{ section.id }}">
  <div class="page-width iwt__inner iwt__inner--{{ section.settings.image_position }} iwt__inner--{{ section.settings.v_align }}">
    <div class="iwt__media" style="--ratio: {{ ratio }};">
      {%- if img != blank -%}
        {{ img | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1100, 1400, 1600', sizes: '(min-width: 990px) 50vw, 100vw', class: 'iwt__img', loading: 'lazy', alt: img.alt }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'iwt__img iwt__placeholder' }}
      {%- endif -%}
    </div>
    <div class="iwt__copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="iwt__heading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
          {%- when 'text' -%}
            <div class="iwt__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a class="btn btn--{{ block.settings.style }}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "audience", "label": "t:sections.common.audience", "options": [
      { "value": "everyone", "label": "t:sections.common.audience_everyone" },
      { "value": "b2b", "label": "t:sections.common.audience_b2b" },
      { "value": "d2c", "label": "t:sections.common.audience_d2c" }
    ], "default": "everyone", "info": "t:sections.common.audience_info" },
    { "type": "image_picker", "id": "image", "label": "t:sections.image_with_text.image" },
    { "type": "select", "id": "image_position", "label": "t:sections.image_with_text.image_position", "options": [
      { "value": "left", "label": "t:sections.image_with_text.left" },
      { "value": "right", "label": "t:sections.image_with_text.right" }
    ], "default": "left" },
    { "type": "select", "id": "ratio", "label": "t:sections.image_with_text.ratio", "options": [
      { "value": "square", "label": "t:sections.image_with_text.ratio_square" },
      { "value": "4-3", "label": "t:sections.image_with_text.ratio_4_3" },
      { "value": "16-9", "label": "t:sections.image_with_text.ratio_16_9" },
      { "value": "adapt", "label": "t:sections.image_with_text.ratio_adapt" }
    ], "default": "4-3" },
    { "type": "select", "id": "v_align", "label": "t:sections.image_with_text.v_align", "options": [
      { "value": "top", "label": "t:sections.image_with_text.top" },
      { "value": "middle", "label": "t:sections.image_with_text.middle" },
      { "value": "bottom", "label": "t:sections.image_with_text.bottom" }
    ], "default": "middle" }
  ],
  "blocks": [
    { "type": "heading", "name": "t:sections.image_with_text.blocks.heading", "limit": 1, "settings": [
      { "type": "text", "id": "text", "label": "t:sections.common.title", "default": "Reorder in under a minute" }
    ]},
    { "type": "text", "name": "t:sections.image_with_text.blocks.text", "limit": 2, "settings": [
      { "type": "richtext", "id": "text", "label": "t:sections.common.text", "default": "<p>Paste your SKUs, check your price and stock, and send the order. Your usual items are one click away.</p>" }
    ]},
    { "type": "button", "name": "t:sections.image_with_text.blocks.button", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "t:sections.common.link_label", "default": "Open quick order" },
      { "type": "url", "id": "link", "label": "t:sections.common.link" },
      { "type": "select", "id": "style", "label": "t:sections.image_with_text.button_style", "options": [
        { "value": "primary", "label": "t:sections.image_banner.style_primary" },
        { "value": "secondary", "label": "t:sections.image_banner.style_secondary" }
      ], "default": "secondary" }
    ]}
  ],
  "presets": [
    { "name": "t:sections.image_with_text.name", "blocks": [ { "type": "heading" }, { "type": "text" }, { "type": "button" } ] }
  ]
}
{% endschema %}
