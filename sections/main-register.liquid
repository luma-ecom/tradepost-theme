<section class="account section" data-section="{{ section.id }}">
  <div class="page-width account__narrow">
    <h1>{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'form' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span class="field__label">{{ 'customer.register.first_name' | t }}</span><input class="field__input" type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="field"><span class="field__label">{{ 'customer.register.last_name' | t }}</span><input class="field__input" type="text" name="customer[last_name]" autocomplete="family-name"></label>
      <label class="field"><span class="field__label">{{ 'customer.login.email' | t }}</span><input class="field__input" type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field"><span class="field__label">{{ 'customer.login.password' | t }}</span><input class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--primary btn--block">{{ 'customer.register.submit_account' | t }}</button>
    {%- endform -%}
    {%- if settings.trade_account_url != blank -%}
      <div class="notice notice--info">{{ 'customer.register.trade_prompt' | t }} <a href="{{ settings.trade_account_url }}">{{ 'products.price.apply_trade' | t }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "t:sections.main_register.name", "tag": "section", "settings": [] }
{% endschema %}
