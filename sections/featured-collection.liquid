{%- assign col = section.settings.collection -%}
<section class="featured section" data-section="{{ section.id }}">
  <div class="page-width">
    <header class="featured__head">
      <h2 class="featured__title">{{ section.settings.title | default: col.title }}</h2>
      {%- if col != blank -%}<a class="featured__all" href="{{ col.url }}">{{ 'collections.view_all' | t }}</a>{%- endif -%}
    </header>
    <div class="product-grid product-grid--{{ section.settings.columns }}">
      {%- if col != blank -%}
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, view: 'grid', section_id: section.id %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <div class="card card--placeholder">{{ 'collections.placeholder' | t }}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "t:sections.common.title" },
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.collection" },
    { "type": "range", "id": "limit", "label": "t:sections.featured_collection.limit", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "range", "id": "columns", "label": "t:sections.featured_collection.columns", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "t:sections.featured_collection.name" } ]
}
{% endschema %}
